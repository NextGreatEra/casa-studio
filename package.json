{
  "name": "casa-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Thin publishing harness for La casa de San Jacinto. GitHub is source of truth; Replit is host.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx server/index.ts",
    "build": "vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "db:push": "drizzle-kit push",
    "preflight": "tsx scripts/preflight.ts",
    "postinstall": "node scripts/copy-fonts.mjs"
  },
  "dependencies": {
    "@fontsource/literata": "5.3.0",
    "@fontsource/source-sans-3": "5.3.0",
    "@pdf-lib/fontkit": "1.1.1",
    "@vitejs/plugin-react": "4.7.0",
    "drizzle-orm": "0.44.7",
    "express": "4.21.2",
    "pdf-lib": "1.17.1",
    "pg": "8.16.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsx": "4.20.6",
    "vite": "6.3.5"
  },
  "devDependencies": {
    "@types/express": "4.17.21",
    "@types/node": "22.15.29",
    "@types/pg": "8.15.4",
    "@types/react": "18.3.23",
    "@types/react-dom": "18.3.7",
    "drizzle-kit": "0.31.4",
    "typescript": "5.8.3"
  }
}
